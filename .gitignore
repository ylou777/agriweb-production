# PRODUCTION DEPLOYMENT - Exclude Docker files (use NIXPACKS)
Dockerfile*
*.dockerignore

# Environnement Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environnement virtuel
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
error.log
logs/

# Cartes générées (fichiers volumineux)
static/cartes/*.html
static/cartes/

# Cache IA
data/ai_analysis_cache/

# Données temporaires
temp/
tmp/
.tmp.driveupload/
*.tmp

# Fichiers système
.DS_Store
Thumbs.db

# Bases de données SQLite (ne pas écraser les utilisateurs en production !)
*.db
*.sqlite
*.sqlite3

# Backups
backup_*/
backup_integration_*/
*.bak

# Fichiers Office temporaires
~$*

# Fichiers compilés Python
*.pyd
*.spec

# Données de test / échantillons
*_sample.json
*_test.geojson

# Sauvegardes JSON
sauvegarde_prospects_*.json

# Fichiers diff/changes temporaires
*_diff.txt
*_changes.txt

# Git history dumps
git_history_*.txt

# Rapports de nettoyage
cleanup_analysis_report.txt

# ── Secrets & fichiers sensibles (ISO 27001 A.8.10 / A.8.24) ──────────────────
# NE JAMAIS committer de secrets : utiliser les variables d'environnement.
*.env
!*_template.env
stripe_config.py
stripe_config.env
users.json
production_users.json
production_licenses.json
*secret*.json
*credentials*.json
*_secrets.json
*_secrets.env
# Rapports d'audit sécurité (détaillent des failles)
SECURITE_*.md
AUDIT_SECURITE*.md
