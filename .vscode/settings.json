{
    "python.testing.unittestArgs": [
        "-v",
        "-s",
        "./__pycache__",
        "-p",
        "*test.py"
    ],
    "python.testing.pytestEnabled": false,
    "python.testing.unittestEnabled": true,
    "github.copilot.nextEditSuggestions.enabled": true,
    "github.copilot.enable": {
        "plaintext": true,
        "markdown": true,
        "scminput": true
    },

    // ========================================
    // OPTIMISATION PERFORMANCES VS CODE
    // ========================================
    
    // Limite les fichiers surveillés pour réduire la RAM
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true,
        "**/.hg/store/**": true,
        "**/__pycache__/**": true,
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/.env/**": true,
        "**/env/**": true,
        "**/*.pyc": true,
        "**/.pytest_cache/**": true,
        "**/.mypy_cache/**": true,
        "**/build/**": true,
        "**/dist/**": true,
        "**/*.egg-info/**": true
    },
    
    // Exclut les dossiers de la recherche pour améliorer les performances
    "search.exclude": {
        "**/.git": true,
        "**/node_modules": true,
        "**/bower_components": true,
        "**/__pycache__": true,
        "**/.venv": true,
        "**/venv": true,
        "**/.env": true,
        "**/env": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/build": true,
        "**/dist": true,
        "**/*.egg-info": true
    },
    
    // Exclut les fichiers de l'explorateur
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true
    },
    
    // Limite le nombre de fichiers ouverts simultanément
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 10,
    "workbench.editor.limit.perEditorGroup": true,
    
    // Désactive les aperçus pour économiser la RAM
    "workbench.editor.enablePreview": false,
    "workbench.editor.enablePreviewFromQuickOpen": false,
    
    // Optimisation Git
    "git.autorefresh": false,
    "git.autofetch": false,
    
    // Optimisation Python
    "python.analysis.memory.keepLibraryAst": false,
    "python.analysis.indexing": false,
    "python.analysis.packageIndexDepths": [
        {
            "name": "",
            "depth": 1
        }
    ],
    
    // Désactive les suggestions automatiques trop gourmandes
    "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": false
    },
    
    // Optimise le terminal
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.persistentSessionReviveProcess": "never",
    
    // Réduit les animations
    "workbench.reduceMotion": "on",
    
    // Désactive la télémétrie
    "telemetry.telemetryLevel": "off",
    
    // Optimise l'affichage des fichiers
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 5000,
    
    // Désactive certaines fonctionnalités gourmandes
    "editor.codeLens": false,
    "editor.lightbulb.enabled": "off",
    "breadcrumbs.enabled": false,
    
    // Optimise le rendu
    "editor.renderWhitespace": "selection",
    "editor.minimap.enabled": false,
    
    // Réduit les workers TypeScript
    "typescript.tsserver.maxTsServerMemory": 2048
}